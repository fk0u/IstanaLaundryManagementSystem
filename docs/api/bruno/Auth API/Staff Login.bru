meta {
  name: Staff Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "kasir@istanalaundry.com",
    "password": "password"
  }
}

script:post-response {
  if (res.status === 200 && res.body.token) {
    bru.setEnvVar("bearer_token", res.body.token);
  }
}
