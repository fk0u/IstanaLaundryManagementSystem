						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 50000,\n  \"payment_method\": \"cash\",\n  \"notes\": \"Pelunasan via Postman\"\n}"
						},
						"url": { "raw": "{{base_url}}/v1/orders/1/payments", "host": ["{{base_url}}"], "path": ["v1", "orders", "1", "payments"] }
					}
				},
				{
					"name": "Request Order Refund",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{bearer_token}}", "type": "string" }] },
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 50000,\n  \"reason\": \"Baju luntur saat cuci\"\n}"
						},
						"url": { "raw": "{{base_url}}/v1/orders/1/refund", "host": ["{{base_url}}"], "path": ["v1", "orders", "1", "refund"] }
					}
				},
				{
					"name": "Get ESC/POS Thermal Receipt JSON",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{bearer_token}}", "type": "string" }] },
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/v1/orders/1/receipt-data", "host": ["{{base_url}}"], "path": ["v1", "orders", "1", "receipt-data"] }
					}
				}
			]
		},
