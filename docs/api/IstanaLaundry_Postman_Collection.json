			]
		},
		{
			"name": "4. Orders, Payments, Refunds & Thermal Receipt",
			"item": [
				{
					"name": "Get Paginated Orders List",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{bearer_token}}", "type": "string" }] },
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/v1/orders?per_page=15", "host": ["{{base_url}}"], "path": ["v1", "orders"], "query": [{ "key": "per_page", "value": "15" }] }
					}
				},
				{
					"name": "Add Order Payment Settlement",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{bearer_token}}", "type": "string" }] },
