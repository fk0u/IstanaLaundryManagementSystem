{
	"info": {
		"_postman_id": "a91b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c5d",
		"name": "Istana Laundry Management System Full REST API Engine",
		"description": "Koleksi API resmi lengkap untuk Istana Laundry Management System Samarinda. Meliputi 10 modul backend ERP: Public, Auth, Dashboard, Orders, CRM Customers, Inventory, HR, Assets, Finance, Procurement, Shifts, dan Master Data.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://istanasystem.alk-tech.my.id/api",
			"type": "string"
		},
		{
			"key": "bearer_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Public API v1 (Compro & Online Order)",
			"item": [
				{
					"name": "Get Active Branches",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/v1/branches", "host": ["{{base_url}}"], "path": ["v1", "branches"] }
					}
				},
				{
					"name": "Get Active Services & Pricing",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/v1/services?branch_id=1", "host": ["{{base_url}}"], "path": ["v1", "services"], "query": [{ "key": "branch_id", "value": "1" }] }
					}
				},
				{
					"name": "Track Order Status (GET)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/v1/track/WJK-202608-0001", "host": ["{{base_url}}"], "path": ["v1", "track", "WJK-202608-0001"] }
					}
				},
				{
					"name": "Submit Online Order with GPS",
					"request": {
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"branch_code\": \"WJK\",\n  \"customer_name\": \"Bpk. Ghani\",\n  \"customer_phone\": \"081234567890\",\n  \"delivery_address\": \"Jl. Air Hitam No. 88, Samarinda\",\n  \"latitude\": -0.4851234,\n  \"longitude\": 117.1423456,\n  \"service_id\": 1,\n  \"quantity\": 5,\n  \"notes\": \"Jemput di pagar hitam depan pos satpam\"\n}"
						},
						"url": { "raw": "{{base_url}}/v1/orders/online", "host": ["{{base_url}}"], "path": ["v1", "orders", "online"] }
					}
				}
			]
		},
		{
			"name": "2. Authentication API",
			"item": [
				{
					"name": "Staff Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.collectionVariables.set('bearer_token', jsonData.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"kasir@istanalaundry.com\",\n  \"password\": \"password\"\n}"
						},
						"url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
					}
				},
				{
					"name": "Get Authenticated User Profile",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{bearer_token}}", "type": "string" }] },
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] }
					}
				}
			]
		},
		{
			"name": "3. Dashboard & Analytics API",
			"item": [
				{
					"name": "Executive KPI Stats",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{bearer_token}}", "type": "string" }] },
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/v1/dashboard/stats", "host": ["{{base_url}}"], "path": ["v1", "dashboard", "stats"] }
					}
				},
				{
					"name": "Monthly Sales Charts",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{bearer_token}}", "type": "string" }] },
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/v1/dashboard/charts", "host": ["{{base_url}}"], "path": ["v1", "dashboard", "charts"] }
					}
				}
			]
		},
		{
			"name": "4. Orders & Transactions API",
			"item": [
				{
					"name": "Get Paginated Orders List",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{bearer_token}}", "type": "string" }] },
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/v1/orders?per_page=15", "host": ["{{base_url}}"], "path": ["v1", "orders"], "query": [{ "key": "per_page", "value": "15" }] }
					}
				},
				{
					"name": "Add Order Payment Settlement",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{bearer_token}}", "type": "string" }] },
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 50000,\n  \"payment_method\": \"cash\",\n  \"notes\": \"Pelunasan via Postman\"\n}"
						},
						"url": { "raw": "{{base_url}}/v1/orders/1/payments", "host": ["{{base_url}}"], "path": ["v1", "orders", "1", "payments"] }
					}
				}
			]
		},
		{
